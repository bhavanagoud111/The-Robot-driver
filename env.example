# Database Configuration (only used by the legacy api_service.py / database.py)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cali_automation
DB_USER=cali_user
DB_PASSWORD=cali_password

# OpenAI API Key (optional; without it the AI Brain uses a rule-based fallback plan)
OPENAI_API_KEY=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Browser automation: set to true to run the browser without a window
# (required where no display is available, e.g. Docker)
HEADLESS=false
